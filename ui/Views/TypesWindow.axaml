<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HarmonyDebugger.UI.ViewModels"
    x:Class="HarmonyDebugger.UI.Views.TypesWindow"
    x:DataType="vm:TypesWindowViewModel"
    Width="650" Height="600"
        Title="Types">
    <Design.DataContext>
        <vm:TypesWindowViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="3*,2*" Margin="10" RowSpacing="6" ColumnSpacing="12">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ChangeTypeNames.Count, StringFormat=Change Types ({0})}" FontWeight="Bold"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ObjectTypeNames.Count, StringFormat=Object Types ({0})}" FontWeight="Bold"/>
        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding ChangeTypeNames}"/>
        <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ObjectTypeNames}"/>
    </Grid>
</Window>
